# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Отдельный сервис конвертации битов (см. mp3-worker/README.md)
# MP3_WORKER_URL=https://your-worker.vercel.app/api/convert
# MP3_WORKER_SECRET=

# Любая длинная случайная строка (латиница/цифры/_/-), придумай сам
WEBHOOK_SECRET=

# Бесплатный ключ из Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Твой Telegram user id (узнать у @userinfobot).
# Ты админ бота: без лимитов, команды /stats /ban /unban, тебе приходят уведомления об ошибках.
OWNER_ID=

# Сколько сообщений к нейросети в сутки на одного человека (по умолчанию 60, 0 = без лимита).
# Ключи нейросетей общие, поэтому лимит защищает твой расход.
# DAILY_LIMIT=60

# Шанс (0..1), что бот сам что-то напишет в группе БЕЗ топиков на сообщение людей (по умолчанию 0.04). 0 = только когда позовут.
# CHATTER_CHANCE=0.04

# Канал, откуда брать картинки для групп: @юзернейм или id (по умолчанию vladavtorx). Бот должен быть админом канала.
# MEME_CHANNEL=vladavtorx

# Защита адреса ежедневных напоминаний (необязательно). Любая длинная строка; Vercel сам шлёт её в заголовке cron.
# CRON_SECRET=

# Юзернейм бота без @ (необязательно: если не задан, бот узнает его сам)
# BOT_USERNAME=my_notes_bot

# База Upstash Redis: эти две переменные Vercel добавит сам,
# когда подключишь Storage -> Upstash Redis к проекту. Без базы бот не работает.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Запасные нейронки (необязательно), N = 2, 3 или 4. Любой API в формате OpenAI.
# LLM2_NAME=Groq
# LLM2_BASE_URL=https://api.groq.com/openai/v1
# LLM2_API_KEY=
# LLM2_MODEL=

# Только для переноса данных из старой версии, если группа не запомнилась в базе.
# После переноса можно удалить.
# GROUP_CHAT_ID=-1001234567890
