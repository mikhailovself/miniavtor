# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Любая длинная случайная строка (латиница/цифры/_/-), придумай сам
WEBHOOK_SECRET=

# Обязательная длинная случайная строка для ежедневного запуска Vercel Cron
CRON_SECRET=

# Бесплатный ключ из Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Твой Telegram user id (узнать у @userinfobot)
OWNER_ID=

# База Upstash Redis: эти две переменные Vercel добавит сам,
# когда подключишь Storage -> Upstash Redis к проекту.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Необязательно (запасной вариант, если не хочешь базу):
# GROUP_CHAT_ID=-1001234567890
# TOPICS={"movies":5,"debts":8,"tracks":11,"ttd":14,"other":2}
