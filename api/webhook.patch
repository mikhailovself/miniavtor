+async function senderForm(uid: string, from: any, text: string): Promise<GC.Form> {
+  const stated = GC.statedForm(text);
+  if (stated !== "?" && uid) {
+    await redis(["SET", `gform:${uid}`, stated, "EX", 2592000]);
